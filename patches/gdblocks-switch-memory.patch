+bool World::apply_coop_patch(Dictionary data, String prefix) {
+    if (!all_loaded || has_task || finalizing_chunks) return false;
+    load_data(data, prefix);
+    TypedArray<Vector3i> coordinates = is_chunk_loaded.keys();
+    for (int c = 0; c < coordinates.size(); ++c) {
+        Vector3i coordinate = coordinates[c];
+        if (!is_chunk_loaded[coordinate] || !chunk_data.has(coordinate)) continue;
+        Chunk *chunk = Object::cast_to<Chunk>(chunk_map[coordinate]);
+        PackedInt32Array next = chunk_data[coordinate];
+        if (next.size() != Chunk::CHUNK_SIZE_X * Chunk::CHUNK_SIZE_Y * Chunk::CHUNK_SIZE_Z) continue;
+        bool changed = chunk->blocks != next;
+        if (changed) {
+            for (int i = 0; i < next.size(); ++i) {
+                int before = chunk->blocks[i], after = next[i];
+                if (before == after) continue;
+                Vector3i at = coordinate + chunk->index_to_position(i);
+                if (is_block_living[before]) { kill_block(at); living_block_map.erase(at); }
+                if (is_block_living[after]) liven_block(at, block_types[after]);
+            }
+            chunk->blocks = next;
+            nx_coop_mesh_queue[coordinate] = true;
+            for (const Vector3i &offset : {Vector3i(Chunk::CHUNK_SIZE_X, 0, 0), Vector3i(-Chunk::CHUNK_SIZE_X, 0, 0), Vector3i(0, Chunk::CHUNK_SIZE_Y, 0), Vector3i(0, -Chunk::CHUNK_SIZE_Y, 0), Vector3i(0, 0, Chunk::CHUNK_SIZE_Z), Vector3i(0, 0, -Chunk::CHUNK_SIZE_Z)}) {
+                const Vector3i adjacent = coordinate + offset;
+                if (is_chunk_loaded.has(adjacent) && is_chunk_loaded[adjacent]) nx_coop_mesh_queue[adjacent] = true;
+            }
+            chunk->modified = true;
+            chunk->dirty = true;
+        }
+        if (chunk_water_data.has(coordinate)) {
+            PackedByteArray next_water = chunk_water_data[coordinate];
+            if (next_water.size() == chunk->water.size() && chunk->water != next_water) {
+                chunk->water = next_water;
+                chunk->water_updated = 1;
+                nx_coop_mesh_queue[coordinate] = true;
+            }
+        }
+        if (chunk_fire_data.has(coordinate)) {
+            PackedByteArray next_fire = chunk_fire_data[coordinate];
+            if (next_fire.size() == chunk->fire.size()) chunk->fire = next_fire;
+        }
+        if (chunk_water_awake_data.has(coordinate)) chunk->water_chunk_awake = chunk_water_awake_data[coordinate];
+    }
+    return true;
+}
+
+void World::process_coop_updates() {
+    if (has_task || finalizing_chunks || nx_coop_mesh_queue.is_empty()) return;
+    TypedArray<Vector3i> coordinates = nx_coop_mesh_queue.keys();
+    Vector3i coordinate = coordinates[0];
+    nx_coop_mesh_queue.erase(coordinate);
+    if (!is_chunk_loaded.has(coordinate) || !is_chunk_loaded[coordinate]) return;
+    Chunk *chunk = Object::cast_to<Chunk>(chunk_map[coordinate]);
+    chunk->calculate_block_statistics();
+    chunk->generate_mesh(true, coordinate);
+    chunk->generate_water_mesh(false, coordinate, true);
+    chunk->generate_water_surface_mesh(false, coordinate, true);
+}
