+func _nx_add_language_row() -> void:
+    var row := HBoxContainer.new()
+    row.name = "NxLanguageRow"
+    var label := Label.new()
+    label.text = "Language"
+    label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
+    row.add_child(label)
+    nx_language_option = OptionButton.new()
+    nx_language_option.name = "NxLanguage"
+    nx_language_option.add_item("English")
+    nx_language_option.add_item("Русский")
+    nx_language_option.item_selected.connect(_nx_language_selected)
+    row.add_child(nx_language_option)
+    var parent := %TabContainer.get_node("Display/MarginContainer/Graphics")
+    parent.add_child(row)
+    parent.move_child(row, 0)
+    NxLocale.language_changed.connect(_nx_update_tab_names)
+    _nx_update_tab_names()
+
+func _nx_language_selected(index: int) -> void:
+    NxLocale.set_language("ru" if index == 1 else "en")
+
+func _nx_update_tab_names() -> void:
+    %RenderDistanceSpinBox.suffix = NxLocale.text("blocks")
+    %FOVSpinBox.suffix = NxLocale.text("degrees")
+    %FpsSpinbox.suffix = NxLocale.text("fps")
+    var tabs: TabContainer = %TabContainer
+    for i in range(tabs.get_tab_count()):
+        tabs.set_tab_title(i, NxLocale.text(str(tabs.get_tab_control(i).name)))
