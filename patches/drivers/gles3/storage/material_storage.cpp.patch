+void MaterialStorage::bind_global_shader_parameters() const {
+#ifdef HORIZON_ENABLED
+    int unit = Config::get_singleton()->max_texture_image_units - 1;
+    glActiveTexture(GL_TEXTURE0 + unit);
+    glBindSampler(unit, 0);
+    glBindTexture(GL_TEXTURE_2D, global_shader_uniforms.buffer);
+    glActiveTexture(GL_TEXTURE0);
+#endif
+}
