 // Applets (album, user page, ...) get too little memory to run the engine;
 // show the "please launch as application" splash instead, as the 3.x port does.
 static int applet_splash_main() {
+    consoleInit(nullptr);
+    printf("Lucid Blocks NX\n\nLaunch with the installed forwarder or full-memory hbmenu.\nAlbum applet mode does not have enough memory.\n\nPress any button to exit.\n");
+    PadState pad;
+    padConfigureInput(1, HidNpadStyleSet_NpadStandard);
+    padInitializeDefault(&pad);
+    while (appletMainLoop()) {
+        padUpdate(&pad);
+        if (padGetButtonsDown(&pad)) break;
+        consoleUpdate(nullptr);
+    }
+    consoleExit(nullptr);
+    return 0;
+}
