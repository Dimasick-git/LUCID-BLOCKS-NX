-
-void switch_clocks_shutdown() {
-	if (!g_clkrst_ok) {
-		return;
-	}
-	if (g_emc_ok) {
-		clkrstCloseSession(&g_emc_session);
-	}
-	if (g_gpu_ok) {
-		clkrstCloseSession(&g_gpu_session);
-	}
-	if (g_cpu_ok) {
-		clkrstCloseSession(&g_cpu_session);
-	}
-	clkrstExit();
