-	printf("Boost clocks applied (%s: CPU 1785 MHz, GPU %d MHz).\n", p_docked ? "docked" : "handheld", p_docked ? 768 : 460);
-	fflush(stdout);
-}
-
-uint32_t switch_clocks_get_gpu_mhz() {
-	if (!g_clkrst_ok || !g_gpu_ok) {
-		return 0;
-	}
-	u32 hz = 0;
-	if (R_FAILED(clkrstGetClockRate(&g_gpu_session, &hz))) {
